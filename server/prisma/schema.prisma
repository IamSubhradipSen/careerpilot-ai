generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String

  resumes     Resume[]
  portfolios  Portfolio[]
  roadmaps    Roadmap[]
  interviews  Interview[]
  jobs        Job[]
  atsAnalyses ATSAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id String @id @default(cuid())

  title       String
  fileName    String
  fileUrl     String
  atsAnalyses ATSAnalysis[]

  uploadedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Portfolio {
  id String @id @default(cuid())

  title       String
  description String
  projectUrl  String
  githubUrl   String
  liveUrl     String
  imageUrl    String

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Roadmap {
  id String @id @default(cuid())

  careerGoal String

  currentSkills String[]

  targetCompanies String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Interview {
  id String @id @default(cuid())

  jobRole    String
  difficulty String
  score      Int?
  feedback   String?

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Job {
  id String @id @default(cuid())

  company  String
  role     String
  status   String
  location String?

  jobUrl String?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model ATSAnalysis {
  id String @id @default(cuid())

  resumeId       String
  jobDescription String

  score Int

  matchedSkills String[]
  missingSkills String[]
  suggestions   String[]

  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
  resume Resume @relation(fields: [resumeId], references: [id])
}
